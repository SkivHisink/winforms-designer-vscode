        <mxCell id="h_v2" value="🚀  2.0.0 PROGRAM — managed parity first; conditional x86/COM and certified vendor tiers" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="40" y="1930" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="h_v2_waves" value="Implementation waves — detailed contracts, issue IDs, corpus, risks and gates: docs/roadmap-v2.0.0-implementation-plan.md" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="40" y="2260" width="1450" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v2_p0" value="&lt;b&gt;P0 — Definition &amp;amp; kill spikes&lt;/b&gt;&lt;br&gt;• ≥100 Visual Studio reference scenarios&lt;br&gt;• ADR 0003 + legal/dependency route&lt;br&gt;• Modern/net48 host + editor broker spikes&lt;br&gt;• Dual-lane cross-tool round-trip&lt;br&gt;• x86/COM include-or-cut gate&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;no production host work before PASS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="2290" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p1" value="&lt;b&gt;P1 — Architecture runway&lt;/b&gt;&lt;br&gt;• Characterize every v1.x contract&lt;br&gt;• Decompose session/render/RPC/webview&lt;br&gt;• Schema-generated protocol + N/N−1&lt;br&gt;• Document store + PatchSet journal&lt;br&gt;• Worker supervisor + self-repair&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;zero behavior/source-output regression&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="2290" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p2" value="&lt;b&gt;P2 — First-party parity&lt;/b&gt;&lt;br&gt;• Standard-control surface + layout&lt;br&gt;• Multi-object properties + events&lt;br&gt;• Toolbox/resources/scaffolding&lt;br&gt;• Containers, strips, inheritance, data&lt;br&gt;• Keyboard/mouse cross-tool workflows&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;Tier A: 100% required scenarios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="2290" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p3" value="&lt;b&gt;P3 — Hosted extensibility&lt;/b&gt;&lt;br&gt;• Contract-tested service kernel&lt;br&gt;• ControlDesigner/adorners/verbs/actions&lt;br&gt;• Converter/editor/collection broker&lt;br&gt;• Approved owned-region serialization&lt;br&gt;• Adapter SDK + hostile component corpus&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;Tier B ≥98%; no fake services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="2290" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p4" value="&lt;b&gt;P4 — Runtime &amp;amp; vendor matrix&lt;/b&gt;&lt;br&gt;• Modern TFM x64/ARM64 workers&lt;br&gt;• net48 x64 live-source authority&lt;br&gt;• Conditional x86/COM/ActiveX&lt;br&gt;• Versioned vendor certification&lt;br&gt;• Dependencies/native/static/build churn&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;Tier C ≥95% per named cohort&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="2570" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p5" value="&lt;b&gt;P5 — Better-than-VS strengths&lt;/b&gt;&lt;br&gt;• Capability inspector&lt;br&gt;• Source/resource patch preview&lt;br&gt;• Headless designer validate for CI&lt;br&gt;• A11y/DPI/localization advisor&lt;br&gt;• Redacted diagnostics + recovery timeline&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;all fixes opt-in, previewed, undoable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="2570" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p6" value="&lt;b&gt;P6 — Beta hardening&lt;/b&gt;&lt;br&gt;• Independent security review&lt;br&gt;• 8-hour / 500-cycle soak&lt;br&gt;• Crash/build/disk-conflict recovery&lt;br&gt;• Frozen perf/memory/handle budgets&lt;br&gt;• Keyboard/AT/contrast/locale/RTL&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;zero open P0/P1 release blockers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="2570" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_p7" value="&lt;b&gt;P7 — RC / GA evidence&lt;/b&gt;&lt;br&gt;• Freeze protocol/config/adapter&lt;br&gt;• Clean-machine package matrix&lt;br&gt;• Runtime/corpus/migration/rollback&lt;br&gt;• Exact counts/hashes/skips/gates&lt;br&gt;• Product/legal/vendor/hardware GO&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;repository closure ≠ external launch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=7;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1180" y="2570" width="350" height="250" as="geometry" /></mxCell>
        <mxCell id="v2_gates" value="&lt;b&gt;v2 GA hard gates — conjunctive&lt;/b&gt;&lt;br&gt;• Tier A 100% · Tier B ≥98% · Tier C ≥95% per advertised cohort · Tier D 100% or excluded by name&lt;br&gt;• Zero silent loss, unrelated diff, arbitrary-source execution, partial transaction, cross-document overwrite or stale canvas presented as current&lt;br&gt;• Cross-tool round-trip · protocol/migration/rollback · soak/recovery · frozen performance · a11y/locales/RTL · package architecture · independent review&lt;br&gt;• Publication, licensed vendors, physical hardware, legal approval and credentials stay explicit PASS / GATED / NOT EXECUTED&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;Estimated capacity: 18–30 months with a stable 6–9 person team; reduce advertised tiers, never safety/truth gates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=9;fontSize=11;fillColor=#f5f0f8;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="40" y="2850" width="1470" height="230" as="geometry" /></mxCell>

