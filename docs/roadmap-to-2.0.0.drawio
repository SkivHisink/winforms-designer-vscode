<mxfile host="app.diagrams.net" agent="codex-roadmap-2" version="24.0.0">
  <diagram id="roadmap-2-0-0" name="Roadmap to 2.0.0">
    <mxGraphModel dx="1600" dy="1650" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="3400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h_title" value="WinForms Designer for VS Code — Release Roadmap   (current 1.15.0 → 2.0.0)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="1.0.0 established the fail-closed trust floor. The 1.x line grows through data-bound, editor, layout/platform, localization, and cross-engine workflow parity. 2.0.0 is reserved for an extensible design-time host and any intentional protocol break." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1300" height="20" as="geometry" />
        </mxCell>

        <mxCell id="h_ship" value="✅  SHIPPED — 0.1.0 → 1.0.0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n010" value="&lt;b&gt;0.1.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Initial preview&lt;/i&gt;&lt;br&gt;• WinForms designer in VS Code (net9)&lt;br&gt;• Copy/paste controls + z-order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="86" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n020" value="&lt;b&gt;0.2.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Property editors &amp;amp; sources&lt;/i&gt;&lt;br&gt;• Property-grid value editors&lt;br&gt;• .resx image support&lt;br&gt;• Layout &amp;amp; control source tracking" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="86" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n030" value="&lt;b&gt;0.3.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;net48 second engine&lt;/i&gt;&lt;br&gt;• Compiled-instance rendering&lt;br&gt;• DevExpress / vendor controls&lt;br&gt;• Pixel-accurate PNG preview" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="86" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n040" value="&lt;b&gt;0.4.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Localization + net48 editing&lt;/i&gt;&lt;br&gt;• UI localization (6 languages)&lt;br&gt;• net48 tab add / delete / rename&lt;br&gt;• Vendor toolbox, cut/paste parity&lt;br&gt;• On-canvas smart-tag Tasks flyout" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="86" width="270" height="180" as="geometry" />
        </mxCell>
        <mxCell id="n050" value="&lt;b&gt;0.5.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Collection editors + trust&lt;/i&gt;&lt;br&gt;• Collection Editors on both engines&lt;br&gt;• Nudge / Duplicate / Reset / bold-nondefault&lt;br&gt;• Lock Controls; cross-runtime routing&lt;br&gt;• Sturdier round-trip; load-failure UX&lt;br&gt;• Live-webview test harness (CI)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1240" y="86" width="270" height="180" as="geometry" />
        </mxCell>

        <mxCell id="n060" value="&lt;b&gt;0.6.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Deeper value editors&lt;/i&gt;&lt;br&gt;• TreeView node editor (images/check/color/font)&lt;br&gt;• ToolStrip/MenuStrip &amp;quot;Type Here&amp;quot; (reorder + add)&lt;br&gt;• Cursor picker; string[] (Lines) editor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="296" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n070" value="&lt;b&gt;0.7.0 + 0.7.1&lt;/b&gt;&lt;br&gt;&lt;i&gt;Item editor grows&lt;/i&gt;&lt;br&gt;• ToolStrip item remove / rename / type picker&lt;br&gt;• 0.7.1: Hindi → 7 languages" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="296" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n080" value="&lt;b&gt;0.8.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;On-canvas item geometry&lt;/i&gt;&lt;br&gt;• Menu/toolbar item rects drawn in place&lt;br&gt;• &amp;quot;Type Here&amp;quot; slot on canvas&lt;br&gt;• Off-tree ContextMenuStrip → tray fix" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="296" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n081" value="&lt;b&gt;0.8.1&lt;/b&gt;&lt;br&gt;&lt;i&gt;On-canvas item editing&lt;/i&gt;&lt;br&gt;• Add (Type-Here + type picker) / rename (F2) / delete&lt;br&gt;• Single-item Properties grid (both engines)&lt;br&gt;• Tray excludes strip items&lt;br&gt;&lt;br&gt;&lt;i&gt;nested + off-tree flyout followed in 0.9.0&lt;/i&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="940" y="296" width="270" height="170" as="geometry" />
        </mxCell>

        <mxCell id="h_road" value="✅  SHIPPED ROAD TO STABLE — 0.9.0 · 0.10.0 · 0.11.0 · 0.12.0 · 1.0.0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n090" value="&lt;b&gt;0.9.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Complete on-canvas strip &amp;amp; context-menu editing&lt;/i&gt;&lt;br&gt;• Nested-submenu item props/rename/delete/add&lt;br&gt;• Off-tree ContextMenuStrip on-canvas editing&lt;br&gt;• ToolStrip overflow-item parity&lt;br&gt;• Item events end-to-end; nested auto-reopen&lt;br&gt;• ImageIndex/ImageKey dropdown foundations&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;shipped&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n100" value="&lt;b&gt;⚠ 0.10.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Safe form lifecycle: detect / preserve / refuse&lt;/i&gt;&lt;br&gt;• net48 whole-file save-safety matrix + enforced byte-local invariant&lt;br&gt;• BinaryFormatter-resx / ImageStream detection → no unsafe regenerate&lt;br&gt;• Localizable=true → honest read-only baseline (editable in 1.5)&lt;br&gt;• Inherited / unresolved-base → honest banner (no typeof(Form) mis-render)&lt;br&gt;• Fail-closed load-failure / partial-render UX&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8a6d00&quot;&gt;the trust floor — most important release&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n110" value="&lt;b&gt;0.11.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;Resource write-safety + ImageList editor&lt;/i&gt;&lt;br&gt;• Atomic / undoable / conflict-checked .resx writes&lt;br&gt;• Verbatim binary/typed resx-node preservation&lt;br&gt;• Minimal generic UITypeEditor / &amp;quot;(Collection)&amp;quot; routing&lt;br&gt;• ImageList editor + ImageIndex/ImageKey WRITE path (binary via net48)&lt;br&gt;• net48 live↔text undo reconcile&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;shipped behind the 0.10 trust gate&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="520" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n120" value="&lt;b&gt;0.12.0&lt;/b&gt;&lt;br&gt;&lt;i&gt;1.0 release candidate: hardening&lt;/i&gt;&lt;br&gt;• Golden-corpus round-trip (modern / net48 / vendor archetypes)&lt;br&gt;• BeginInit / events / component-reference re-verification&lt;br&gt;• Capability preflight: supported / limited / read-only unambiguous&lt;br&gt;• Modifiers design-time editor&lt;br&gt;• Broader live-webview + cross-runtime regression&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2E7D32&quot;&gt;shipped&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="520" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1_0_0" value="&lt;b&gt;✓ 1.0.0 — SHIPPED&lt;/b&gt;&lt;br&gt;&lt;i&gt;Stable foundation — out of preview&lt;/i&gt;&lt;br&gt;• Stable modern .NET 8 / 9 / 10 workflow&lt;br&gt;• Live-source net48 interpretation + disclosed fallback&lt;br&gt;• Data-loss invariant: round-trip &lt;b&gt;or&lt;/b&gt; safe-refuse&lt;br&gt;• Public capability matrix + named refusal reasons&lt;br&gt;• Atomic/conflict-checked saves and release preflight" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1240" y="520" width="270" height="230" as="geometry" />
        </mxCell>

        <mxCell id="h_beyond" value="✓  1.x THROUGH 1.15 REPOSITORY-SIDE COMPLETE · 2.0.0 MAJOR BOUNDARY — outcome milestones, not calendar commitments" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="768" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n1_1" value="&lt;b&gt;✓ 1.1.0 — SHIPPED&lt;/b&gt;&lt;br&gt;&lt;i&gt;Daily workflow &amp;amp; project integration&lt;/i&gt;&lt;br&gt;• Complete .NET Choose Items discovery&lt;br&gt;• Persist locks / zoom / tab + tree state&lt;br&gt;• ImageList reorder + key rename&lt;br&gt;• Automatic net48 build/release coordination&lt;br&gt;• Actionable per-target fallback diagnostics&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met: daily work needs no manual recovery steps&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="798" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1_2" value="&lt;b&gt;★ 1.2.0 — RELEASE CANDIDATE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Data-bound forms&lt;/i&gt;&lt;br&gt;• BindingSource / DataSource / DataBindings UI&lt;br&gt;• DataGridView styles, formats, binding editors&lt;br&gt;• Tray icons + rename + extender workflows&lt;br&gt;• Typed cross-form copy/paste dependencies&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met: routine LOB binding work needs no code edits&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="340" y="798" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1_3" value="&lt;b&gt;✓ 1.3.0 — CLOSED BY 1.4&lt;/b&gt;&lt;br&gt;&lt;i&gt;General editor framework&lt;/i&gt;&lt;br&gt;• Bounded IList / IList&amp;lt;T&amp;gt; source adapters&lt;br&gt;• Recursive TypeConverter metadata + limits&lt;br&gt;• Isolated Color / Font UITypeEditor worker&lt;br&gt;• One-undo source-first editor transactions&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met: supported editors use metadata/adapters&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="798" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1_4" value="&lt;b&gt;✓ 1.4.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Layout, inheritance, DPI &amp;amp; ARM64&lt;/i&gt;&lt;br&gt;• Explicit inherited ownership + server gates&lt;br&gt;• TLP / Flow tools + outline reparent/reorder&lt;br&gt;• Engine-authoritative modern geometry commits&lt;br&gt;• Fractional HiDPI matrix + native ARM64 VSIX&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="798" width="270" height="230" as="geometry" />
        </mxCell>
        <mxCell id="n1_5" value="&lt;b&gt;✓ 1.5.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Enterprise localization&lt;/i&gt;&lt;br&gt;• Executable ApplyResources on both engines&lt;br&gt;• Neutral → parent → exact culture overlays&lt;br&gt;• Lossless scalar/image/RTL resource edits&lt;br&gt;• Atomic resource-set undo/conflict safety&lt;br&gt;• Cross-runtime fallback + mirroring corpus&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; native UX/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1240" y="798" width="270" height="230" as="geometry" />
        </mxCell>

        <mxCell id="n1_6" value="&lt;b&gt;✓ 1.6.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Workflow parity &amp;amp; release hardening&lt;/i&gt;&lt;br&gt;• Modern + net48 TabControl canvas parity&lt;br&gt;• Durable per-form selected-page view state&lt;br&gt;• Fully translated localization-culture UX&lt;br&gt;• Unsupported COM/WPF Choose Items fail closed&lt;br&gt;• CI/release coverage + webview syntax parity&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="450" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n1_7" value="&lt;b&gt;✓ 1.7.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Safe tab ordering&lt;/i&gt;&lt;br&gt;• Adjacent Move Left / Right on both engines&lt;br&gt;• Canonical Add / AddRange source ordering&lt;br&gt;• Exact-permutation safety gate + edge no-op&lt;br&gt;• Compiled-fallback live collection parity&lt;br&gt;• Active page and unrelated source preserved&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="1080" width="450" height="250" as="geometry" />
        </mxCell>
        <mxCell id="n2_0" value="&lt;b&gt;★ 2.0.0 — VISUAL STUDIO-CLASS PARITY&lt;/b&gt;&lt;br&gt;&lt;i&gt;Extensible, source-safe design-time platform inside VS Code&lt;/i&gt;&lt;br&gt;• Exact/workflow/compatible parity for advertised WinForms tiers&lt;br&gt;• One command bus + dual minimal/owned-region persistence lanes&lt;br&gt;• Contract-tested design services, designers, verbs, action lists &amp;amp; editors&lt;br&gt;• Runtime × architecture × project × trust-tier worker supervision&lt;br&gt;• Capability inspector, patch preview, headless validation &amp;amp; recovery&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6A1B9A&quot;&gt;Phase 0 gates must pass; parity is an evidence claim, not a label&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="1990" width="1470" height="250" as="geometry" />
        </mxCell>

        <mxCell id="h_planned" value="✓  1.x REPOSITORY-SIDE COMPLETE — next planned boundary is 2.0.0" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="40" y="1360" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n1_8" value="&lt;b&gt;✓ 1.8.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Placement override + self-maintaining toolbox&lt;/i&gt;&lt;br&gt;• Alt suppresses snapping for one gesture&lt;br&gt;• Lazy owning-project control discovery&lt;br&gt;• Cache + watcher + explicit budgets&lt;br&gt;• Workspace user add/remove survives a rescan&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1390" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_9" value="&lt;b&gt;✓ 1.9.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Daily loop + project items&lt;/i&gt;&lt;br&gt;• Explorer Add: Form / UserControl / Component / Class (#4)&lt;br&gt;• Rename a control — (Name) + F2&lt;br&gt;• Double-click → real DefaultEvent (#5)&lt;br&gt;• F7 / Shift+F7 code ↔ designer&lt;br&gt;• Tab / Shift+Tab / Esc / Ctrl+A&lt;br&gt;• Live position + size readout&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="1390" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_10" value="&lt;b&gt;✓ 1.10.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Multi-object properties&lt;/i&gt;&lt;br&gt;• Shared-property intersection&lt;br&gt;• Mixed values shown as mixed&lt;br&gt;• One transaction over all targets&lt;br&gt;• Multi-object Reset where representable&lt;br&gt;• Categorized / Alphabetical toggle&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="1390" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_11" value="&lt;b&gt;✓ 1.11.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Precision layout&lt;/i&gt;&lt;br&gt;• SnapLines / SnapToGrid / None modes&lt;br&gt;• Align to Grid stops being disabled&lt;br&gt;• Margin/Padding-aware snaplines&lt;br&gt;• Text-baseline snaplines&lt;br&gt;• Spacing +/−/remove · Ctrl+drag copy&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1390" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_12" value="&lt;b&gt;✓ 1.12.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Toolbox creation and placing&lt;/i&gt;&lt;br&gt;• Toolbox double-click inserts a default-sized control&lt;br&gt;• Draw-a-rectangle creates at the exact requested size&lt;br&gt;• Preserve parent, position and selection on both engines&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1660" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_13" value="&lt;b&gt;✓ 1.13.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Assets and menu productivity&lt;/i&gt;&lt;br&gt;• Pick a canonical existing project resource&lt;br&gt;• On-canvas item drag-reorder / reparent&lt;br&gt;• Separators + Insert Standard Items&lt;br&gt;• Unknown statements stay byte-identical&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="1660" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_14" value="&lt;b&gt;✓ 1.14.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Visual inheritance overrides&lt;/i&gt;&lt;br&gt;• Ownership + effective accessibility&lt;br&gt;• Allowlisted property and geometry overrides&lt;br&gt;• Emitted/reset only in the derived class&lt;br&gt;• Exact-base reconciliation fails closed&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="1660" width="350" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n1_15" value="&lt;b&gt;✓ 1.15.0 — REPO-SIDE COMPLETE&lt;/b&gt;&lt;br&gt;&lt;i&gt;Bounded data-binding productivity&lt;/i&gt;&lt;br&gt;• Data Sources pane for recognized DTO/settings metadata&lt;br&gt;• Detail/grid generation + BindingSource/Navigator wiring&lt;br&gt;• Existing DataGridView column append preserves hand-written columns&lt;br&gt;• Forged/stale/unsafe providers fail closed&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot;&gt;exit met locally; hardware/vendor/publish gates remain&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1180" y="1660" width="350" height="240" as="geometry" />
