<Project Sdk="Microsoft.NET.Sdk">

  <!-- e2e fixture: compiles the SAME engine/samples/ContextMenuForm.Designer.cs the net9 leg renders from source
       into a real net48 assembly, so the e2e can drive the net48 engine's RenderCompiledWithLayout on it and assert
       the two engines AGREE on the off-tree-ContextMenuStrip partition (controls vs tray). Not part of any engine
       build (it lives outside engine/ and engine-net48/); built on demand by extension/src/e2e.ts. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Net48CtxFixture</AssemblyName>
    <RootNamespace>SampleApp</RootNamespace>
    <!-- VendorLike deliberately models a legacy vendor property without modern source-generation metadata. -->
    <NoWarn Condition="'$(TargetFramework)' == 'net10.0-windows'">$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reuse the exact samples the net9 legs render (same input → cross-runtime parity). -->
    <Compile Include="..\..\engine\samples\ContextMenuForm.Designer.cs" Link="ContextMenuForm.Designer.cs" />
    <!-- OVERFLOW parity: the ToolStrip narrower than its buttons → net48's Show pump places the excess items in overflow. -->
    <Compile Include="..\..\engine\samples\ToolStripOverflowForm.Designer.cs" Link="ToolStripOverflowForm.Designer.cs" />
    <!-- ImageIndex/ImageKey dropdown: the compiled instance's ImageList really holds its keyed images (Images.Add), so
         describe's context-aware ImageKeyConverter enumerates real keys (net9's source interpreter can't run Images.Add). -->
    <Compile Include="..\..\engine\samples\ImageListForm.Designer.cs" Link="ImageListForm.Designer.cs" />
    <!-- Component-reference dropdown: the compiled instance's AcceptButton/CancelButton (control refs) and
         okButton.ContextMenuStrip (a component ref) let describe self-enumerate the sibling field names and TryApply
         resolve a picked name to the live instance (net48's converter can't, being un-sited). -->
    <Compile Include="..\..\engine\samples\ComponentRefForm.Designer.cs" Link="ComponentRefForm.Designer.cs" />
    <!-- TRAY-component reference dropdown: notifyIcon1.ContextMenuStrip = contextMenuStrip1 — a reference whose OWNER is
         a non-Control tray Component. The compiled instance lets describe enumerate the ContextMenuStrip field names and
         TryApply's reference branch resolve a picked name to the live component (the tray-owner write path). -->
    <Compile Include="..\..\engine\samples\NotifyIconForm.Designer.cs" Link="NotifyIconForm.Designer.cs" />
    <!-- 0.10.0 S2 VISUAL-INHERITANCE pair: DerivedForm : InheritedBaseForm : Form. Both partials of BOTH forms must
         compile into ONE assembly so the net48 engine can instantiate the concrete DerivedForm and render baseButton
         (from the base) AND derivedButton — proving net48 has NO inherited-form gap (so it emits no banner), unlike
         net9 which drops baseButton. Framework-only, so they compile cleanly here (the vendor : XtraForm fixture is
         net9 fallback-only and intentionally NOT linked). -->
    <Compile Include="..\..\engine\samples\InheritedBaseForm.Designer.cs" Link="InheritedBaseForm.Designer.cs" />
    <Compile Include="..\..\engine\samples\InheritedBaseForm.cs" Link="InheritedBaseForm.cs" />
    <Compile Include="..\..\engine\samples\DerivedForm.Designer.cs" Link="DerivedForm.Designer.cs" />
    <Compile Include="..\..\engine\samples\DerivedForm.cs" Link="DerivedForm.cs" />
    <!-- TREEVIEW: nodes serialized as LOCAL variables (bottom-up) + Nodes.AddRange — the TreeNode interpreter subsystem. -->
    <Compile Include="..\..\engine\samples\TreeForm.Designer.cs" Link="TreeForm.Designer.cs" />
    <Compile Include="..\..\engine\samples\TreeForm.cs" Link="TreeForm.cs" />
    <!-- TABCONTROL (M4 Slice 5): TabControl + TabPages via Controls.Add + SelectedIndex — for interpreted tab view-state. -->
    <Compile Include="..\..\engine\samples\TabForm.Designer.cs" Link="TabForm.Designer.cs" />
    <Compile Include="..\..\engine\samples\TabForm.cs" Link="TabForm.cs" />
    <!-- OFF-SCREEN CONTAINMENT: HostileForm.Designer.cs + HostileForm.cs live in THIS directory (the SDK compiles
         them implicitly, like the other local fixtures here) — a form that maximizes itself AND opens another window
         from Load, the two ways a real application's form used to put windows on the user's screen when the preview
         realized it. Not in engine/samples because only the compiled (net48) engine instantiates the real type. -->
  </ItemGroup>

  <ItemGroup>
    <!-- S079 intentionally exercises the product's live-source/localizable overlay. Keep these neighboring resources
         out of the compiled fixture so the net48 route cannot satisfy the scenario from a stale satellite assembly. -->
    <EmbeddedResource Remove="LocalizableForm.resx" />
    <EmbeddedResource Remove="LocalizableForm.ar-SA.resx" />
  </ItemGroup>

</Project>
